# Copy to .env on the server and fill in real values. Do NOT commit .env.
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain-or-vps-ip,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain

# SMTP for order-confirmation emails. Leave EMAIL_HOST empty to print emails
# to the console (local dev). For Gmail use an App Password, not your password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=PrimePantry <you@gmail.com>
